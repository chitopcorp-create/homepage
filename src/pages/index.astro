---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroVideo from '@/components/HeroVideo.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import company from '@/data/company.json';
import projectsData from '@/data/projects.json';

const highlights = projectsData.projects
  .filter((p) => p.highlight)
  .sort((a, b) => Number(b.year) - Number(a.year));
---

<BaseLayout fullBleedHero>
  <HeroVideo />

  <section id="highlights" class="bg-gray-50 py-20">
    <div class="mx-auto max-w-7xl px-4 lg:px-8">
      <div class="text-center">
        <p class="text-sm font-semibold uppercase tracking-widest text-gold">Portfolio</p>
        <h2 class="mt-2 text-3xl font-bold text-navy md:text-4xl">최근 사업실적</h2>
        <p class="mx-auto mt-4 max-w-2xl text-gray-600">
          토지매입부터 인허가, 시공, 임대업까지 수행 중인 주요 프로젝트를 소개합니다.
        </p>
      </div>
      <div class="mt-12 grid auto-rows-fr items-stretch gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          highlights.map((project) => (
            <div class="h-full min-h-0">
              <ProjectCard {...project} />
            </div>
          ))
        }
      </div>
      <div class="mt-10 text-center">
        <a
          href="/projects"
          class="inline-flex items-center rounded border-2 border-navy px-8 py-3 text-sm font-semibold text-navy transition hover:bg-navy hover:text-white"
        >
          전체 실적 보기
        </a>
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="mx-auto max-w-7xl px-4 lg:px-8">
      <div class="text-center">
        <p class="text-sm font-semibold uppercase tracking-widest text-gold">Business</p>
        <h2 class="mt-2 text-3xl font-bold text-navy">사업분야</h2>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          company.businessAreas.map((area) => (
            <div class="rounded-lg border border-gray-100 bg-white p-6 shadow-sm transition hover:shadow-md">
              <h3 class="text-lg font-bold text-navy">{area.title}</h3>
              <p class="mt-3 text-sm text-gray-600">{area.description}</p>
            </div>
          ))
        }
      </div>
      <div class="mt-10 text-center">
        <a href="/about" class="text-sm font-semibold text-gold transition hover:underline">
          회사소개 더보기 →
        </a>
      </div>
    </div>
  </section>

  <section class="bg-navy py-16 text-white">
    <div class="mx-auto max-w-7xl px-4 text-center lg:px-8">
      <h2 class="text-2xl font-bold md:text-3xl">새로운 공간의 시작, 승민종합건설(주)이 함께하겠습니다.</h2>
      <p class="mx-auto mt-4 max-w-xl text-white/70">
        건축·개발 관련 문의는 대표전화로 연락해 주시고 사업제안서로 저희의 역량을 확인하세요.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a
          href={`tel:${company.tel.replace(/-/g, '')}`}
          class="rounded bg-gold px-6 py-3 text-sm font-semibold text-navy transition hover:bg-gold-light"
        >
          {company.tel}
        </a>
        <a
          href="/media#proposal"
          class="rounded border border-white/40 px-6 py-3 text-sm font-semibold transition hover:border-gold hover:text-gold"
        >
          사업제안서
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
