---
import EnvironmentGreenSiteCard from '@/components/EnvironmentGreenSiteCard.astro';

const companyName = '승민종합건설(주)';

const formatBoldCompany = (text: string) => {
  const parts = text.split(companyName);
  if (parts.length === 1) return text;
  return parts
    .map((part, i) => (i === 0 ? part : `<strong class="font-extrabold">${companyName}</strong>${part}`))
    .join('');
};

const introText =
  '승민종합건설(주)는 1994년부터 이어온 “환경보전과 인간존중”의 정신을 계승하여, 임직원 모두가 환경·안전·보건 중심의 ESH(Environment, Safety, Health) 경영을 적극 실천하고, 건설현장에서는 자연친화적 시공과 자원순환형 현장 운영을 통해 사람과 자연이 조화롭게 공존하는 지속가능한 건설문화를 만들어가겠습니다.';

const practiceText =
  '승민종합건설(주)는 자연친화적 자재와 순환골재의 사용을 확대하고, 에너지 절약형 건축물 시공을 실천함으로써 환경오염을 사전에 예방하며, 지속적인 환경개선 활동을 통해 지속가능한 친환경 건설문화를 만들어가겠습니다.';

const greenSiteCards = [
  {
    slides: [
      {
        src: '/images/sustainability/environment-site/building.png',
        alt: '녹색건축·에너지효율등급 인증 대정타워 건축 조감도',
        objectFit: 'cover' as const,
      },
      {
        src: '/images/sustainability/environment-site/green-building-cert.png',
        alt: '대정타워 녹색건축 인증서 (일반 그린4등급)',
        objectFit: 'contain' as const,
      },
      {
        src: '/images/sustainability/environment-site/energy-efficiency-cert.png',
        alt: '길동 412-9 의료시설 신축공사 건축물 에너지효율등급 인증서 (1++등급)',
        objectFit: 'contain' as const,
      },
    ],
    labels: ['녹색건축(일반(그린4등급))', '에너지효율등급(1++)'],
  },
  {
    slides: [
      {
        src: '/images/sustainability/environment-site-2/01-building.png',
        alt: 'SM엘루이 주상복합 건축 조감도',
        objectFit: 'cover' as const,
      },
      {
        src: '/images/sustainability/environment-site-2/02-green-cert.png',
        alt: 'SM엘루이 주상복합 녹색건축인증 (우수 그린2등급)',
        objectFit: 'contain' as const,
      },
      {
        src: '/images/sustainability/environment-site-2/03-green-cert-detail.png',
        alt: 'SM엘루이 주상복합 녹색건축 인증서',
        objectFit: 'contain' as const,
      },
      {
        src: '/images/sustainability/environment-site-2/04-energy-1plus.png',
        alt: 'SM엘루이 주상복합(비주거) 건축물 에너지효율등급 인증서 (1+등급)',
        objectFit: 'contain' as const,
      },
      {
        src: '/images/sustainability/environment-site-2/05-energy-grade2.png',
        alt: 'SM엘루이 주상복합(주거) 건축물 에너지효율등급 인증서 (2등급)',
        objectFit: 'contain' as const,
      },
    ],
    labels: ['녹색건축(우수(그린2등급))', '에너지효율등급(1+,2등급)'],
  },
  {
    slides: [
      {
        src: '/images/sustainability/environment-site-3/01-building.png',
