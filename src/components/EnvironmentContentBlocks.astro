---

<div class="environment-content mx-auto max-w-7xl px-4 lg:px-8">
  <section class="environment-content__block pb-14 md:pb-20 lg:pb-24">
    <div class="environment-content__row grid gap-4 md:grid-cols-[12rem_1fr] md:items-start md:gap-10 lg:grid-cols-[14rem_1fr]">
      <h3 class="text-2xl font-bold leading-snug text-[#38bdf8] md:text-3xl lg:text-[2rem]">
        ESH·친환경<br />경영방침
      </h3>
      <p
        class="text-lg font-bold leading-[1.85] text-gray-900 md:text-xl"
        set:html={formatBoldCompany(introText)}
      />
    </div>
  </section>

  <hr class="environment-content__divider border-0 border-t border-gray-200/90" aria-hidden="true" />

  <section class="environment-content__block pt-14 md:pt-20 lg:pt-24">
    <div class="environment-content__row grid gap-8 md:grid-cols-[12rem_1fr] md:items-start md:gap-10 lg:grid-cols-[14rem_1fr]">
      <h3 class="text-2xl font-bold leading-snug text-[#38bdf8] md:text-3xl lg:text-[2rem]">
        녹색경영<br />도입현장
      </h3>
      <div class="space-y-8 md:space-y-10">
        <p
          class="text-lg font-bold leading-[1.85] text-gray-900 md:text-xl"
          set:html={formatBoldCompany(practiceText)}
        />

        <div class="green-site-cards">
          {greenSiteCards.map((card) => (
            <EnvironmentGreenSiteCard slides={card.slides} labels={card.labels} />
          ))}
        </div>
      </div>
    </div>
  </section>
</div>

<style>
  .green-site-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 11rem));
    gap: 1rem;
    align-items: start;
  }

  @media (min-width: 640px) {
    .green-site-cards {
      grid-template-columns: repeat(4, minmax(0, 13rem));
      gap: 1.5rem;
    }
  }
</style>

<script>
  const equalizeGreenSiteLabelHeights = () => {
    document.querySelectorAll('.green-site-cards').forEach((grid) => {
      const labels = Array.from(grid.querySelectorAll<HTMLElement>('.green-site-card__labels'));
      if (!labels.length) return;

      labels.forEach((el) => {
        el.style.minHeight = '';
      });

      const maxHeight = Math.max(...labels.map((el) => el.getBoundingClientRect().height));
      if (maxHeight <= 0) return;

      labels.forEach((el) => {
        el.style.minHeight = `${maxHeight}px`;
      });
    });
  };

  const scheduleGreenSiteLayout = () => {
    requestAnimationFrame(() => {
      equalizeGreenSiteLabelHeights();
    });
  };

  scheduleGreenSiteLayout();
  window.addEventListener('resize', scheduleGreenSiteLayout, { passive: true });
  document.fonts?.ready.then(scheduleGreenSiteLayout);

  document.querySelectorAll('[data-green-site-carousel]').forEach((root) => {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-green-site-slide]'));
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-green-site-prev]');
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-green-site-next]');
    if (!slides.length || !prevBtn || !nextBtn) return;

    let index = 0;

    const showSlide = (next: number) => {
      index = (next + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        const active = i === index;
        slide.classList.toggle('opacity-100', active);
        slide.classList.toggle('opacity-0', !active);
        slide.classList.toggle('pointer-events-none', !active);
        slide.hidden = !active;
      });
    };

    prevBtn.addEventListener('click', () => showSlide(index - 1));
    nextBtn.addEventListener('click', () => showSlide(index + 1));
  });
</script>
