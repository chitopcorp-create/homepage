---
import company from '@/data/company.json';

const videoSrc = '/videos/hero.mp4';
const posterSrc = '/images/hero-poster.webp';
const mobileImageSrc = '/images/hero-mobile.webp';
const mobileImageFallback = '/images/hero-mobile.jpg';
const modalTitle = `${company.nameMain} 홍보영상`;
const contactLocationHref = '/about#location';
const contactTelHref = `tel:${company.tel.replace(/[^\d+]/g, '')}`;
---

<section id="hero-section" class="hero-video-section relative w-full overflow-hidden bg-black" aria-label="메인 영상">
  <picture class="hero-mobile-picture md:hidden">
    <source srcset={mobileImageSrc} type="image/webp" />
    <img
      src={mobileImageFallback}
      alt=""
      class="hero-mobile-img"
      width={1200}
      height={1600}
      fetchpriority="high"
      decoding="async"
    />
  </picture>

  <div
    class="hero-mobile-tagline pointer-events-none absolute left-0 right-0 z-10 flex flex-col items-center px-6 text-center md:hidden"
    aria-hidden="false"
  >
    <p class="hero-mobile-tagline__main font-bold leading-snug tracking-tight text-white">
      「환경보존과 인간존중」
    </p>
    <p class="hero-mobile-tagline__since mt-2.5 font-semibold tracking-[0.35em] text-white/90">
      SINCE 1994
    </p>
  </div>

  <div class="hero-mobile-lower pointer-events-none absolute inset-x-0 z-10 flex flex-col items-center px-5 text-center md:hidden">
    <p class="hero-mobile-intro font-semibold leading-relaxed text-white/95">
      승민종합건설(주)는 땅의 가능성을 발견하고, 공간의 가치를 도시 위에 완성합니다.
    </p>
    <p class="hero-mobile-intro mt-2 font-semibold leading-relaxed text-white/95">
      고객보다 한발 앞선 제안과 책임 있는 명품시공으로 더 큰 만족을 실현하겠습니다.
    </p>
    <div class="hero-contact-oval pointer-events-auto mt-4 flex items-center justify-center">
      <button
        type="button"
        id="hero-contact-open"
        class="hero-contact-oval__btn inline-flex items-center justify-center rounded-full font-bold tracking-[0.18em] text-white transition active:opacity-90"
        aria-haspopup="dialog"
        aria-controls="hero-contact-sheet"
        aria-expanded="false"
      >
        CONTACT
      </button>
    </div>
  </div>

  <div
    id="hero-contact-sheet"
    class="hero-contact-sheet fixed inset-0 z-[65] hidden items-end justify-center bg-black/45 p-4 pb-8 md:hidden"
    role="dialog"
    aria-modal="true"
    aria-labelledby="hero-contact-sheet-title"
    hidden
  >
    <div class="w-full max-w-sm overflow-hidden rounded-2xl bg-white shadow-2xl">
      <p id="hero-contact-sheet-title" class="border-b border-gray-100 px-5 py-4 text-center text-sm font-bold tracking-wide text-navy">
        CONTACT
      </p>
      <div class="flex flex-col p-2">
        <a
          href={contactLocationHref}
          class="flex min-h-[3.25rem] items-center justify-center rounded-xl px-4 text-base font-semibold text-navy transition hover:bg-gray-50"
        >
          오시는길
        </a>
        <a
          href={contactTelHref}
          class="flex min-h-[3.25rem] items-center justify-center rounded-xl px-4 text-base font-semibold text-[#38bdf8] transition hover:bg-gray-50"
        >
          전화하기
        </a>
      </div>
      <button
        type="button"
        id="hero-contact-close"
        class="w-full border-t border-gray-100 py-3.5 text-sm font-medium text-gray-500 transition hover:bg-gray-50"
      >
        닫기
      </button>
    </div>
  </div>

  <video
    id="hero-video"
    class="hero-video hidden md:block"
    width={1920}
    height={1080}
    poster={posterSrc}
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    disablepictureinpicture
    disableremoteplayback
  >
    <source src={videoSrc} type="video/mp4" />
  </video>

  <button
    type="button"
    id="hero-play-open"
    class="hero-play-btn absolute right-4 bottom-6 z-10 flex h-12 w-12 items-center justify-center rounded-full bg-navy/55 text-white shadow-lg backdrop-blur-sm transition hover:bg-navy/75 md:hidden"
    aria-label="홍보 영상 재생"
    aria-controls="hero-video-modal"
    aria-expanded="false"
  >
    <svg class="ml-0.5 h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M8 5v14l11-7z" />
    </svg>
  </button>

  <a
    href="#highlights"
    class="hero-scroll-hint absolute bottom-6 left-1/2 z-10 flex -translate-x-1/2 flex-col items-center gap-1 text-white/90 transition hover:text-white md:bottom-8"
    aria-label="아래 콘텐츠로 이동"
  >
    <span class="text-[11px] font-semibold tracking-wide">SCROLL</span>
    <svg class="h-6 w-6 animate-bounce" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </a>
</section>

<div
  id="hero-video-modal"
  class="hero-video-modal fixed inset-0 z-[70] hidden items-center justify-center bg-black/60 p-4 sm:p-6"
  role="dialog"
  aria-modal="true"
  aria-labelledby="hero-video-modal-title"
  hidden
>
  <div class="hero-video-window w-full max-w-4xl overflow-hidden rounded-lg shadow-2xl" role="document">
    <div class="hero-video-window__titlebar flex items-center gap-3 border-b border-gray-200 bg-[#ececec] px-3 py-2.5 sm:px-4">
      <div class="flex shrink-0 items-center gap-1.5" aria-hidden="true">
        <span class="hero-window-dot hero-window-dot--close" />
        <span class="hero-window-dot hero-window-dot--min" />
        <span class="hero-window-dot hero-window-dot--max" />
      </div>
      <p id="hero-video-modal-title" class="min-w-0 flex-1 truncate text-xs font-medium text-gray-700 sm:text-sm">
        {modalTitle}
      </p>
      <button
        type="button"
        id="hero-play-close"
        class="flex h-7 w-7 shrink-0 items-center justify-center rounded text-gray-500 transition hover:bg-gray-300/80 hover:text-gray-800"
        aria-label="영상 닫기"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
    <div class="hero-video-window__body bg-[#1a1a1a] p-2 sm:p-3">
      <div class="hero-video-modal__frame mx-auto w-full">
        <video
          id="hero-modal-video"
          class="hero-video-modal__player"
          width={1920}
          height={1080}
          poster={posterSrc}
          controls
          playsinline
          preload="metadata"
        >
          <source src={videoSrc} type="video/mp4" />
        </video>
      </div>
    </div>
  </div>
</div>

<style>
  .hero-video-section {
    height: 100svh;
    height: 100dvh;
    min-height: 100svh;
    min-height: 100dvh;
    transform: translateZ(0);
  }

  .hero-mobile-picture,
  .hero-mobile-img,
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
  }

  .hero-mobile-picture {
    display: block;
  }

  .hero-video {
    transform: translateZ(0);
    backface-visibility: hidden;
  }

  @media (min-width: 768px) {
    .hero-mobile-picture {
      display: none;
    }

    .hero-video {
      display: block;
    }
  }

  .hero-mobile-tagline {
    top: calc(var(--site-header-height, 5.5rem) + 2rem);
  }

  .hero-mobile-tagline__main {
    font-size: clamp(1.375rem, 5.2vw, 1.75rem);
    text-shadow:
      0 2px 12px rgba(0, 0, 0, 0.55),
      0 1px 4px rgba(0, 0, 0, 0.4);
  }

  .hero-mobile-tagline__since {
    font-size: clamp(0.875rem, 3.2vw, 1.0625rem);
    text-shadow:
      0 2px 12px rgba(0, 0, 0, 0.55),
      0 1px 4px rgba(0, 0, 0, 0.4);
  }

  .hero-mobile-lower {
    top: 58%;
    bottom: 5.25rem;
    justify-content: flex-start;
  }

  .hero-mobile-intro {
    max-width: 22rem;
    font-size: clamp(0.875rem, 3.2vw, 1.0625rem);
    text-shadow:
      0 2px 12px rgba(0, 0, 0, 0.55),
      0 1px 4px rgba(0, 0, 0, 0.4);
  }

  .hero-contact-oval {
    padding: 0.35rem 0.65rem;
    min-width: min(9rem, 39vw);
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.22);
    box-shadow:
      0 4px 16px rgba(0, 0, 0, 0.28),
      inset 0 1px 0 rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .hero-contact-oval__btn {
    min-height: 1.375rem;
    min-width: 5.25rem;
    padding: 0.3rem 0.75rem;
    font-size: 0.625rem;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.45);
  }

  .hero-contact-sheet.is-open {
    display: flex;
  }

  .hero-scroll-hint {
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.45);
  }

  .hero-play-btn {
    text-shadow: none;
  }

  .hero-window-dot {
    display: block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .hero-window-dot--close {
    background: #ff5f57;
  }

  .hero-window-dot--min {
    background: #febc2e;
  }

  .hero-window-dot--max {
    background: #28c840;
  }

  .hero-video-modal__frame {
    aspect-ratio: 16 / 9;
    max-height: min(72vh, calc(100dvh - 8rem));
    width: 100%;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-video-modal__player {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #000;
  }
</style>

<script>
  const video = document.getElementById('hero-video') as HTMLVideoElement | null;
  const mq = window.matchMedia('(min-width: 768px)');

  const playVideo = () => {
    if (!video || !mq.matches) return;
    video.setAttribute('playsinline', '');
    video.muted = true;
    video.play().catch(() => {});
  };

  const pauseVideo = () => {
    if (!video || mq.matches) return;
    video.pause();
  };

  if (video) {
    playVideo();
    mq.addEventListener('change', () => {
      if (mq.matches) playVideo();
      else pauseVideo();
    });
    video.addEventListener('loadeddata', playVideo, { once: true });
    document.addEventListener(
      'visibilitychange',
      () => {
        if (document.visibilityState === 'visible') playVideo();
      },
      { passive: true }
    );
    if (!mq.matches) pauseVideo();
  }

  const playOpen = document.getElementById('hero-play-open');
  const playClose = document.getElementById('hero-play-close');
  const modal = document.getElementById('hero-video-modal');
  const modalVideo = document.getElementById('hero-modal-video') as HTMLVideoElement | null;

  const openHeroModal = () => {
    if (!modal || !modalVideo) return;
    modal.removeAttribute('hidden');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    playOpen?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    modalVideo.currentTime = 0;
    modalVideo.play().catch(() => {});
    playClose?.focus();
  };

  const closeHeroModal = () => {
    if (!modal || !modalVideo) return;
    modalVideo.pause();
    modalVideo.currentTime = 0;
    modal.setAttribute('hidden', '');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    playOpen?.setAttribute('aria-expanded', 'false');
    if (!contactSheet || contactSheet.hasAttribute('hidden')) document.body.style.overflow = '';
    playOpen?.focus();
  };

  playOpen?.addEventListener('click', openHeroModal);
  playClose?.addEventListener('click', closeHeroModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeHeroModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.hasAttribute('hidden')) closeHeroModal();
  });

  const contactOpen = document.getElementById('hero-contact-open');
  const contactClose = document.getElementById('hero-contact-close');
  const contactSheet = document.getElementById('hero-contact-sheet');

  const isHeroModalOpen = () => modal && !modal.hasAttribute('hidden');

  const openContactSheet = () => {
    if (!contactSheet || !contactOpen) return;
    contactSheet.removeAttribute('hidden');
    contactSheet.classList.add('is-open');
    contactOpen.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  };

  const closeContactSheet = () => {
    if (!contactSheet || !contactOpen) return;
    contactSheet.setAttribute('hidden', '');
    contactSheet.classList.remove('is-open');
    contactOpen.setAttribute('aria-expanded', 'false');
    if (!isHeroModalOpen()) document.body.style.overflow = '';
    contactOpen.focus();
  };

  contactOpen?.addEventListener('click', openContactSheet);
  contactClose?.addEventListener('click', closeContactSheet);
  contactSheet?.addEventListener('click', (e) => {
    if (e.target === contactSheet) closeContactSheet();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && contactSheet && !contactSheet.hasAttribute('hidden')) closeContactSheet();
  });
</script>
