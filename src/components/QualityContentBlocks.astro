---
import QualityPdcaDiagram from '@/components/QualityPdcaDiagram.astro';

const companyNameParen = '승민종합건설(주)';
const companyNameCorp = '승민종합건설㈜';

const formatBoldCompany = (text: string, name: string) => {
  const parts = text.split(name);
  if (parts.length === 1) return text;
  return parts
    .map((part, i) => (i === 0 ? part : `<strong class="font-extrabold">${name}</strong>${part}`))
    .join('');
};

const policyText =
  '품질은 단순한 결과가 아니라, 모든 과정의 기준이자 고객 신뢰를 지탱하는 근본입니다. 승민종합건설(주)은 처음부터 끝까지 흔들림 없는 품질 원칙을 바탕으로, 오래도록 가치 있는 공간을 만들어갑니다.';

const systemText =
  '승민종합건설㈜은 글로벌 품질경영시스템(ISO9001) 인증 취득을 통해 도면검토, 자재발주, 시공, 건물관리 등 모든 분야에 걸쳐 품질 경영을 실시하고 있습니다. 오랜 기간 쌓인 건설현장의 다양한 경험과 지식을 시스템화 하여 모든 현장에 최고의 품질을 유지할 수 있도록 관리하고 있습니다.';
---

<div class="quality-content mx-auto max-w-7xl px-4 lg:px-8">
  <section class="quality-content__block pb-14 md:pb-20 lg:pb-24">
    <div class="quality-content__row grid gap-4 md:grid-cols-[12rem_1fr] md:items-start md:gap-10 lg:grid-cols-[14rem_1fr]">
      <h3 class="text-2xl font-bold text-[#38bdf8] md:text-3xl lg:text-[2rem]">품질방침</h3>
      <div class="space-y-8 md:space-y-10">
        <p
          class="text-lg font-bold leading-[1.85] text-gray-900 md:text-xl"
          set:html={formatBoldCompany(policyText, companyNameParen)}
        />
        <div class="-mx-4 lg:-mx-0">
          <QualityPdcaDiagram />
        </div>
      </div>
    </div>
  </section>

  <hr class="quality-content__divider border-0 border-t border-gray-200/90" aria-hidden="true" />

  <section class="quality-content__block pt-14 md:pt-20 lg:pt-24">
    <div class="quality-content__row grid gap-4 md:grid-cols-[12rem_1fr] md:items-start md:gap-10 lg:grid-cols-[14rem_1fr]">
      <h3 class="text-2xl font-bold leading-snug text-[#38bdf8] md:text-3xl lg:text-[2rem]">
        품질경영<br class="hidden sm:block" />시스템 구축
      </h3>
      <div class="space-y-8 md:space-y-10">
        <p
          class="text-lg font-bold leading-[1.85] text-gray-900 md:text-xl"
          set:html={formatBoldCompany(systemText, companyNameCorp)}
        />
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 sm:gap-8">
          <figure class="quality-cert-frame flex aspect-[3/4] items-center justify-center overflow-hidden rounded-sm border border-gray-200 bg-white p-2 shadow-sm sm:p-3">
            <img
              src="/images/sustainability/quality-system-certificate.png"
              alt="승민종합건설(주) 품질시스템 인증서 (KS A 9001 : 2001, ISO 9001 : 2000)"
              class="max-h-full max-w-full object-contain"
              width="800"
              height="1100"
              loading="lazy"
            />
          </figure>
          <figure class="quality-cert-frame flex aspect-[3/4] items-center justify-center overflow-hidden rounded-sm border border-gray-200 bg-white p-2 shadow-sm sm:p-3">
            <img
              src="/images/sustainability/quality-iso-certificate.png"
              alt="승민종합건설(주) ISO 9001 품질경영시스템 인증서 (KS A 9001 : 2001, ISO 9001 : 2000)"
              class="max-h-full max-w-full object-contain"
              width="800"
              height="1100"
              loading="lazy"
            />
          </figure>
        </div>
      </div>
    </div>
  </section>
</div>
