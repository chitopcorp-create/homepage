---
import BrandMark from '@/components/BrandMark.astro';
import nav from '@/data/navigation.json';

const currentPath = Astro.url.pathname;
const normalizedPath = currentPath.replace(/\/$/, '') || '/';
const immersiveHeroPaths = ['/about', '/projects', '/sustainability', '/media'];
const isHome = currentPath === '/' || currentPath === '/index.html';
const isImmersiveHeroPage = immersiveHeroPaths.includes(normalizedPath);
const useTransparentHeader = isHome || isImmersiveHeroPage;
const isActive = (href: string) => {
  const base = href.split('#')[0].split('?')[0];
  return base === '/' ? currentPath === '/' : currentPath.startsWith(base);
};

const navGap =
  'gap-10 pr-2 md:gap-12 lg:gap-16 lg:pr-6 xl:gap-20 xl:pr-10';
---

<header
  id="site-header"
  class:list={[
    'group/header fixed top-0 left-0 right-0 z-50 border-b transition-[background-color,border-color,box-shadow] duration-300 ease-out',
    useTransparentHeader ? 'header-over-video' : 'header-visible bg-white border-gray-200 shadow-none',
  ]}
  data-home={isHome ? 'true' : 'false'}
  data-immersive-hero={isImmersiveHeroPage ? 'true' : 'false'}
>
  <div class="header-bar relative mx-auto max-w-7xl px-3 lg:px-8 xl:pl-10">
    <div class="flex w-full items-center justify-between gap-3 pt-3 lg:gap-4 lg:pt-4">
      <a
        href="/"
        class="group flex min-w-0 flex-1 items-center overflow-hidden pr-2 transition hover:opacity-90 md:flex-none md:pr-0"
        aria-label="홈"
      >
        <BrandMark variant="header" />
      </a>

      <nav
        id="desktop-nav"
        class:list={['hidden flex-1 items-stretch justify-end self-stretch md:flex', navGap]}
        aria-label="주메뉴"
      >
        {
          nav.items.map((item) => (
            <div class="nav-item relative flex items-center self-stretch">
              <a
                href={item.href}
                class:list={[
                  'nav-link block whitespace-nowrap py-2 text-lg font-semibold tracking-wide transition-[color] duration-200 md:text-xl lg:text-[1.35rem] xl:text-2xl',
                  isActive(item.href) ? 'is-active' : '',
                ]}
              >
                {item.label}
              </a>
              <span class="nav-accent" aria-hidden="true"></span>
              {item.children?.length ? (
                <ul
                  class="nav-submenu pointer-events-none invisible absolute left-0 top-[calc(100%+3px)] z-20 flex min-w-[9.5rem] flex-col items-start gap-1 pt-4 opacity-0 transition-[opacity,visibility] duration-200"
                  aria-label={`${item.label} 하위 메뉴`}
                >
                  {item.children.map((child) => (
                    <li class="w-full">
                      <a
                        href={child.href}
                        class="nav-sub-link block whitespace-nowrap py-1.5 text-[15px] font-semibold text-gray-600 transition-colors duration-200 lg:text-base"
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              ) : null}
            </div>
          ))
        }
      </nav>

      <div class="flex shrink-0 items-center md:min-w-[2.75rem]">
        <button
          type="button"
          id="mobile-menu-btn"
          class="header-menu-btn -mr-1 relative flex h-11 w-11 shrink-0 items-center justify-center rounded md:hidden"
          aria-label="메인메뉴 열기"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg
            class="header-icon-menu h-7 w-7"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg
            class="header-icon-close absolute h-7 w-7 opacity-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 6l12 12M18 6L6 18" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div
    id="header-mega"
    class="header-mega invisible absolute left-0 right-0 top-full bg-white opacity-0 transition-[opacity,visibility] duration-200"
    aria-hidden="true"
  >
    <div class="mx-auto max-w-7xl px-3 pb-10 pt-2 lg:px-8" aria-hidden="true"></div>
  </div>

  <div
    id="mobile-menu-backdrop"
    class="mobile-menu-backdrop fixed inset-0 z-[44] hidden bg-black/45 md:hidden"
    aria-hidden="true"
  />

  <div
    id="mobile-menu"
    class="mobile-menu-drawer fixed left-0 right-0 bottom-0 z-[45] hidden flex-col overflow-hidden bg-white md:hidden"
    style="top: var(--site-header-height, 5.5rem);"
    aria-hidden="true"
  >
    <div class="mobile-menu-drawer__head flex shrink-0 items-center justify-end border-b border-gray-200 px-4 py-3">
      <button
        type="button"
        id="mobile-menu-close"
        class="text-sm font-medium text-gray-600 transition hover:text-navy"
      >
        메인메뉴 닫기
      </button>
    </div>

    <nav class="mobile-menu-nav min-h-0 flex-1 overflow-y-auto overscroll-contain" aria-label="모바일 메뉴">
      {
        nav.items.map((item) => {
          const submenuId = `mobile-submenu-${item.href.replace(/^\//, '').split(/[#?]/)[0] || 'home'}`;
          const hasChildren = (item.children?.length ?? 0) > 0;

          return (
            <div class="mobile-nav-item border-b border-gray-200" data-mobile-accordion>
              {hasChildren ? (
                <>
                  <div class="flex min-h-[3.5rem] items-stretch">
                    <button
                      type="button"
                      class="mobile-accordion-toggle flex min-w-0 flex-1 items-center px-5 text-left text-[1.0625rem] font-bold tracking-tight text-navy transition hover:bg-gray-50 hover:text-gold"
                      aria-expanded="false"
                      aria-controls={submenuId}
                    >
                      {item.label}
                    </button>
                    <button
                      type="button"
                      class="mobile-accordion-toggle flex w-14 shrink-0 items-center justify-center text-gray-400 transition hover:bg-gray-50 hover:text-gold"
                      aria-expanded="false"
                      aria-controls={submenuId}
                      aria-label={`${item.label} 하위 메뉴`}
                    >
                      <svg
                        class="mobile-accordion-chevron h-5 w-5 shrink-0 transition-transform duration-300 ease-out"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        aria-hidden="true"
                      >
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                      </svg>
                    </button>
                  </div>
                  <div id={submenuId} class="mobile-accordion-panel grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out">
                    <div class="overflow-hidden">
                      <ul class="border-t border-gray-100 bg-[#f5f6f8]">
                        {item.children!.map((child) => (
                          <li class="border-b border-gray-200/80 last:border-b-0">
                            <a
                              href={child.href}
                              class="mobile-sub-link block whitespace-nowrap overflow-hidden text-ellipsis px-5 py-3.5 text-[0.9375rem] font-medium text-gray-700 transition hover:text-gold"
                            >
                              {child.label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>
                </>
              ) : (
                <a
                  href={item.href}
                  class:list={[
                    'mobile-nav-link flex min-h-[3.5rem] items-center px-5 text-[1.0625rem] font-bold tracking-tight text-navy transition hover:text-gold',
                    isActive(item.href) ? 'text-gold' : '',
                  ]}
                >
                  {item.label}
                </a>
              )}
            </div>
          );
        })
      }
    </nav>
  </div>
</header>

<style>
  #site-header.header-mobile-open .header-icon-menu {
    opacity: 0;
  }

  #site-header.header-mobile-open .header-icon-close {
    opacity: 1;
  }

  .mobile-accordion-panel.is-open {
    grid-template-rows: 1fr;
  }

  .mobile-nav-item:has(.mobile-accordion-panel.is-open) .mobile-accordion-chevron {
    transform: rotate(180deg);
  }

  .mobile-nav-item:has(.mobile-accordion-panel.is-open) .mobile-accordion-toggle {
    color: #c9a227;
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenuClose = document.getElementById('mobile-menu-close');
  const mobileMenuBackdrop = document.getElementById('mobile-menu-backdrop');
  const mobileMenu = document.getElementById('mobile-menu');
  const mega = document.getElementById('header-mega');
  const desktopNav = document.getElementById('desktop-nav');
  const isHome = header?.dataset.home === 'true';
  const isImmersiveHero = header?.dataset.immersiveHero === 'true';

  const solidHeaderClasses = ['header-visible', 'bg-white', 'border-gray-200', 'shadow-none'];
  const videoHeaderClasses = ['header-over-video'];

  let megaOpen = false;

  const closeAllMobileAccordions = () => {
    if (!mobileMenu) return;
    mobileMenu.querySelectorAll<HTMLElement>('.mobile-accordion-panel').forEach((panel) => {
      panel.classList.remove('is-open');
    });
    mobileMenu.querySelectorAll<HTMLButtonElement>('.mobile-accordion-toggle').forEach((btn) => {
      btn.setAttribute('aria-expanded', 'false');
    });
  };

  const toggleMobileAccordion = (controlsId: string) => {
    if (!mobileMenu) return;
    const panel = document.getElementById(controlsId);
    if (!panel) return;

    const isOpen = panel.classList.contains('is-open');
    closeAllMobileAccordions();

    if (!isOpen) {
      panel.classList.add('is-open');
      mobileMenu
        .querySelectorAll<HTMLButtonElement>(`.mobile-accordion-toggle[aria-controls="${controlsId}"]`)
        .forEach((btn) => btn.setAttribute('aria-expanded', 'true'));
    }
  };

  const setMobileMenuOpen = (open: boolean) => {
    if (!mobileMenu || !menuBtn) return;

    mobileMenu.classList.toggle('hidden', !open);
    mobileMenu.classList.toggle('flex', open);
    mobileMenu.setAttribute('aria-hidden', String(!open));
    mobileMenuBackdrop?.classList.toggle('hidden', !open);
    mobileMenuBackdrop?.setAttribute('aria-hidden', String(!open));
    menuBtn.setAttribute('aria-expanded', String(open));
    menuBtn.setAttribute('aria-label', open ? '메인메뉴 닫기' : '메인메뉴 열기');
    header?.classList.toggle('header-mobile-open', open);
    document.body.style.overflow = open ? 'hidden' : '';

    if (open) {
      hideMega();
      setSolidBar();
      syncHeaderHeight();
      closeAllMobileAccordions();
    } else {
      closeAllMobileAccordions();
      updateHeaderOnScroll();
    }
  };

  const syncMegaPanelHeight = () => {
    if (!mega || !desktopNav) return;
    const inner = mega.firstElementChild as HTMLElement | null;
    if (!inner) return;
    const submenus = desktopNav.querySelectorAll<HTMLElement>('.nav-submenu');
    let maxBottom = 0;
    submenus.forEach((panel) => {
      const bottom = panel.offsetTop + panel.offsetHeight;
      if (bottom > maxBottom) maxBottom = bottom;
    });
    inner.style.minHeight = megaOpen && maxBottom > 0 ? `${maxBottom + 16}px` : '';
  };

  const setSolidBar = () => {
    header?.classList.remove(...videoHeaderClasses);
    header?.classList.add(...solidHeaderClasses);
  };

  const setOverVideo = () => {
    if (megaOpen) return;
    header?.classList.remove(...solidHeaderClasses);
    header?.classList.add(...videoHeaderClasses);
    if (mobileMenu && !mobileMenu.classList.contains('hidden')) {
      setMobileMenuOpen(false);
    }
  };

  const showMega = () => {
    if (!mega || !desktopNav?.querySelector('.nav-submenu')) return;
    megaOpen = true;
    header?.classList.add('header-menu-open');
    setSolidBar();

    mega.classList.remove('invisible', 'opacity-0');
    mega.classList.add('visible', 'opacity-100');
    mega.setAttribute('aria-hidden', 'false');

    requestAnimationFrame(syncMegaPanelHeight);
  };

  const hideMega = () => {
    if (!mega) return;
    megaOpen = false;
    header?.classList.remove('header-menu-open');

    mega.classList.add('invisible', 'opacity-0');
    mega.classList.remove('visible', 'opacity-100');
    mega.setAttribute('aria-hidden', 'true');

    const inner = mega.firstElementChild as HTMLElement | null;
    if (inner) inner.style.minHeight = '';
  };

  const syncHeaderHeight = () => {
    const headerBar = document.querySelector<HTMLElement>('.header-bar');
    const height = headerBar?.offsetHeight ?? header?.offsetHeight ?? 88;
    document.documentElement.style.setProperty('--site-header-height', `${height}px`);
  };

  const updateHeaderOnScroll = () => {
    if (isImmersiveHero) {
      hideMega();
      const stickyBar = document.querySelector<HTMLElement>('[data-sticky-submenu-bar]');
      const headerH = header?.offsetHeight ?? 88;
      const tabStuck =
        !!stickyBar &&
        stickyBar.getBoundingClientRect().top <= headerH + 1 &&
        window.scrollY > 32;

      if (tabStuck) {
        setSolidBar();
      } else if (!megaOpen) {
        setOverVideo();
      }
      return;
    }

    if (!isHome) {
      hideMega();
      setSolidBar();
      return;
    }

    const hero = document.getElementById('hero-section');
    const heroBottom = hero ? hero.offsetTop + hero.offsetHeight : window.innerHeight;
    if (window.scrollY >= heroBottom - 1) {
      hideMega();
      setSolidBar();
    } else if (!megaOpen) {
      setOverVideo();
    }
  };

  desktopNav?.addEventListener('mouseenter', showMega);
  desktopNav?.addEventListener('focusin', showMega);
  mega?.addEventListener('mouseenter', showMega);

  header?.addEventListener('mouseleave', () => {
    hideMega();
    updateHeaderOnScroll();
  });

  header?.addEventListener('focusout', (e) => {
    if (!header.contains(e.relatedTarget as Node)) {
      hideMega();
      updateHeaderOnScroll();
    }
  });

  syncHeaderHeight();

  if (!isHome && !isImmersiveHero) {
    setSolidBar();
  }

  mobileMenu?.querySelectorAll<HTMLButtonElement>('.mobile-accordion-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const controlsId = btn.getAttribute('aria-controls');
      if (controlsId) toggleMobileAccordion(controlsId);
    });
  });

  mobileMenu?.querySelectorAll<HTMLAnchorElement>('.mobile-nav-link, .mobile-sub-link').forEach((link) => {
    link.addEventListener('click', () => setMobileMenuOpen(false));
  });

  menuBtn?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.contains('hidden') ?? true;
    setMobileMenuOpen(isOpen);
  });

  mobileMenuClose?.addEventListener('click', () => setMobileMenuOpen(false));
  mobileMenuBackdrop?.addEventListener('click', () => setMobileMenuOpen(false));

  window.addEventListener('scroll', updateHeaderOnScroll, { passive: true });
  window.addEventListener('resize', () => {
    syncHeaderHeight();
    if (window.matchMedia('(min-width: 768px)').matches && mobileMenu && !mobileMenu.classList.contains('hidden')) {
      setMobileMenuOpen(false);
    }
    updateHeaderOnScroll();
    if (megaOpen) syncMegaPanelHeight();
  }, { passive: true });
  updateHeaderOnScroll();
</script>
