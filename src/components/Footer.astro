---
import BrandMark from '@/components/BrandMark.astro';
import company from '@/data/company.json';
import nav from '@/data/navigation.json';
const year = new Date().getFullYear();
---

<footer id="site-footer" class="site-footer text-gray-700">
  <div class="mx-auto max-w-7xl px-4 py-14 lg:px-8 xl:pl-10">
    <div class="grid gap-10 md:grid-cols-3">
      <div class="pt-5 md:pt-6">
        <a href="/" class="inline-block transition hover:opacity-90">
          <BrandMark variant="footer" />
        </a>
      </div>
      <div>
        <p class="mb-4 text-sm font-bold text-navy">바로가기</p>
        <ul class="space-y-2.5 text-sm">
          {
            nav.items.map((item) => (
              <li>
                <a href={item.href} class="transition hover:text-gold">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <p class="mb-4 text-sm font-bold text-navy">연락처</p>
        <ul class="space-y-1.5 text-sm">
          <li>{company.address}</li>
          <li>Tel. {company.tel}</li>
          <li>Fax. {company.fax}</li>
          <li>
            <a href={`mailto:${company.email}`} class="transition hover:text-gold">{company.email}</a>
          </li>
        </ul>
      </div>
    </div>
    <div class="site-footer-divider mt-10 border-t pt-6 text-xs text-gray-500">
      <p>
        {company.businessNumber && `사업자등록번호 ${company.businessNumber} | `}
        대표 {company.ceo} | {company.nameFull}
      </p>
      <p class="mt-1">© {year} {company.nameEn}. All rights reserved.</p>
    </div>
  </div>
</footer>
