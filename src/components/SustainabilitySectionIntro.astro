---
interface Props {
  title: string;
  lead?: string;
  heroImage?: string;
  heroCaption?: string | string[];
  heroCaptionLong?: boolean;
}

const { title, lead, heroImage, heroCaption, heroCaptionLong } = Astro.props;
const captionLines = heroCaption
  ? Array.isArray(heroCaption)
    ? heroCaption
    : [heroCaption]
  : [];
const captionClass = heroCaptionLong
  ? 'max-w-4xl px-2 text-base sm:text-lg md:max-w-5xl md:text-xl md:leading-relaxed lg:text-[1.35rem]'
  : 'text-xl sm:text-2xl md:text-3xl lg:text-[2rem] lg:leading-snug';
---

<header class="sustainability-section-intro mx-auto max-w-7xl px-4 text-center lg:px-8">
  <h2 class="text-3xl font-bold leading-snug text-[#38bdf8] md:text-4xl lg:text-[2.5rem] lg:leading-tight">
    {title}
  </h2>
  {lead && <p class="mx-auto mt-6 max-w-3xl text-base leading-relaxed text-gray-600 md:text-lg">{lead}</p>}
</header>

{
  heroImage && (
    <figure class="sustainability-hero mx-auto mt-8 w-full max-w-[min(96vw,72rem)] px-4 lg:mt-10 lg:px-6">
      <div class="sustainability-hero__frame relative mx-auto overflow-hidden rounded-sm shadow-lg">
        <img
          src={heroImage}
          alt=""
          class="block h-full w-full object-cover"
          loading="lazy"
          width="1680"
          height="720"
        />
        <div class="sustainability-hero__overlay" aria-hidden="true"></div>
        {
          captionLines.length > 0 && (
            <figcaption class="sustainability-hero__caption">
              <p class:list={['mx-auto space-y-2 font-bold leading-relaxed text-white', captionClass]}>
                {captionLines.map((line) => (
                  <span class="block">{line}</span>
                ))}
              </p>
            </figcaption>
          )
        }
      </div>
    </figure>
  )
}

<style>
  .sustainability-hero__frame {
    aspect-ratio: 21 / 9;
    width: 100%;
    max-height: min(38vh, 18rem);
  }

  @media (min-width: 768px) {
    .sustainability-hero__frame {
      max-height: min(40vh, 22rem);
    }
  }

  .sustainability-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(15, 31, 61, 0.15) 0%,
      rgba(15, 31, 61, 0.45) 55%,
      rgba(15, 31, 61, 0.55) 100%
    );
  }

  .sustainability-hero__caption {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    text-align: center;
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.35);
  }
</style>
