---
---

<div class="overview-banner" aria-label="회사개요 비전">
  <div class="overview-banner__frame">
    <img
      src="/images/overview-building.png"
      alt=""
      class="overview-banner__image"
      width="1920"
      height="820"
      loading="lazy"
      decoding="async"
    />
    <div class="overview-banner__overlay" aria-hidden="true"></div>
    <p class="overview-banner__headline">
      <span>고객만족과</span>
      <span>환경친화적 공간창조</span>
    </p>
  </div>
</div>

<style>
  .overview-banner {
    width: 100%;
  }

  .overview-banner__frame {
    position: relative;
    width: 100%;
    aspect-ratio: 21 / 8;
    min-height: 16rem;
    max-height: 32rem;
    overflow: hidden;
  }

  .overview-banner__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .overview-banner__overlay {
    position: absolute;
    inset: 0;
    background: rgba(10, 21, 41, 0.35);
  }

  .overview-banner__headline {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0 1.5rem;
    text-align: center;
    font-size: clamp(1.75rem, 4.5vw, 3.25rem);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: #fff;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.4);
  }

  @media (min-width: 768px) {
    .overview-banner__frame {
      aspect-ratio: 21 / 7;
      min-height: 18rem;
      max-height: 28rem;
    }
  }
</style>
