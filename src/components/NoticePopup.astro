---
import site from '@/data/site.json';

const notice = site.notice;
---

{
  notice.enabled && (
    <div
      id="notice-popup"
      class="fixed inset-0 z-[60] hidden items-center justify-center bg-black/50 p-4"
      role="dialog"
      aria-modal="true"
      aria-labelledby="notice-title"
    >
      <div class="w-full max-w-md rounded-lg bg-white p-6 shadow-2xl">
        <h2 id="notice-title" class="text-lg font-bold text-navy">
          {notice.title}
        </h2>
        <p class="mt-3 text-sm text-gray-600">{notice.content}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href={notice.link}
            class="rounded bg-navy px-4 py-2 text-sm font-medium text-white transition hover:bg-navy-light"
          >
            {notice.linkText}
          </a>
          <button
            type="button"
            id="notice-close"
            class="rounded border border-gray-300 px-4 py-2 text-sm transition hover:bg-gray-50"
          >
            닫기
          </button>
        </div>
        <label class="mt-4 flex items-center gap-2 text-xs text-gray-500">
          <input type="checkbox" id="notice-hide-today" class="rounded" />
          오늘 하루 보지 않기
        </label>
      </div>
    </div>
  )
}

<script>
  const popup = document.getElementById('notice-popup');
  const closeBtn = document.getElementById('notice-close');
  const hideToday = document.getElementById('notice-hide-today') as HTMLInputElement | null;
  const STORAGE_KEY = 'notice-hidden-date';

  const shouldShow = () => {
    const hidden = localStorage.getItem(STORAGE_KEY);
    if (!hidden) return true;
    const today = new Date().toDateString();
    return hidden !== today;
  };

  if (popup && shouldShow()) {
    popup.classList.remove('hidden');
    popup.classList.add('flex');
  }

  const closePopup = () => {
    if (hideToday?.checked) {
      localStorage.setItem(STORAGE_KEY, new Date().toDateString());
    }
    popup?.classList.add('hidden');
    popup?.classList.remove('flex');
  };

  closeBtn?.addEventListener('click', closePopup);
  popup?.addEventListener('click', (e) => {
    if (e.target === popup) closePopup();
  });
</script>
